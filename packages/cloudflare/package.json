{
  "name": "@vaduno/cloudflare",
  "version": "0.7.0",
  "description": "Spend firewall for the Cloudflare Agents SDK x402 client. Wraps your signer so Vaduno policy runs inside signTypedData — a denied payment never has a signature. Never holds funds or keys to funds; you keep your own key.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premsreelathasugeendran/vaduno.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/premsreelathasugeendran/vaduno#readme",
  "bugs": "https://github.com/premsreelathasugeendran/vaduno/issues",
  "license": "MIT",
  "keywords": [
    "cloudflare",
    "agents",
    "x402",
    "ai-agents",
    "payments",
    "spend-control",
    "usdc",
    "agentic-commerce"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@vaduno/guard": "^0.7.0"
  },
  "peerDependencies": {
    "viem": ">=2.21.0 <3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@x402/evm": "^2.21.0",
    "agents": "^0.20.1",
    "typescript": "^5.5.4",
    "viem": "^2.21.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@vaduno/postgres",
  "version": "0.2.0",
  "description": "Postgres-backed SpendLimiter and ConsumeStore for Vaduno. Makes rolling spend caps and consume-once mandates hold across MULTIPLE INSTANCES, not just one process. Never holds funds or keys to funds.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premsreelathasugeendran/vaduno.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://github.com/premsreelathasugeendran/vaduno#readme",
  "bugs": "https://github.com/premsreelathasugeendran/vaduno/issues",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "payments",
    "spend-control",
    "postgres",
    "guardrails",
    "agentic-commerce"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@vaduno/guard": "^0.2.0"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

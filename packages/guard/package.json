{
  "name": "@vaduno/guard",
  "version": "0.2.1",
  "description": "Spend firewall + tamper-evident audit ledger for AI agents. Policy-gates any payment call with deterministic rules, signed consume-once mandates, and a hash-chained flight recorder. Never holds funds or keys to funds.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premsreelathasugeendran/vaduno.git",
    "directory": "packages/guard"
  },
  "homepage": "https://github.com/premsreelathasugeendran/vaduno#readme",
  "bugs": "https://github.com/premsreelathasugeendran/vaduno/issues",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "payments",
    "spend-control",
    "audit",
    "guardrails",
    "agentic-commerce"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@vaduno/x402",
  "version": "0.2.0",
  "description": "x402 rail adapter for Vaduno. Governs HTTP 402 stablecoin payments with policy, mandates, and a tamper-evident audit trail. Never signs or holds keys to funds — you plug in your own payer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premsreelathasugeendran/vaduno.git",
    "directory": "packages/x402"
  },
  "license": "MIT",
  "keywords": [
    "x402",
    "ai-agents",
    "payments",
    "stablecoin",
    "usdc",
    "agentic-commerce"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@vaduno/guard": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

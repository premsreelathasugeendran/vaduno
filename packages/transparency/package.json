{
  "name": "@vaduno/transparency",
  "version": "0.3.0",
  "description": "RFC 9162 (Certificate Transparency v2) Merkle transparency log for Vaduno's audit trail. Turns the hash-chained ledger into an append-only Merkle tree with signed tree heads, inclusion proofs (non-omission), and consistency proofs (append-only). Never holds funds or keys to funds.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premsreelathasugeendran/vaduno.git",
    "directory": "packages/transparency"
  },
  "homepage": "https://github.com/premsreelathasugeendran/vaduno#readme",
  "bugs": "https://github.com/premsreelathasugeendran/vaduno/issues",
  "license": "MIT",
  "keywords": [
    "transparency-log",
    "merkle-tree",
    "rfc9162",
    "rfc6962",
    "certificate-transparency",
    "tamper-evident",
    "audit",
    "ai-agents",
    "payments"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@vaduno/guard": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
